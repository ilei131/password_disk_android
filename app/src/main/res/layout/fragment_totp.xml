<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <!-- 标题区 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/space_md"
        android:paddingEnd="@dimen/screen_padding">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/two_factor_code"
            android:textAppearance="@style/TextAppearance.PasswordDisk.Display"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/totp_page_desc"
            android:textAppearance="@style/TextAppearance.PasswordDisk.Subtitle" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="@dimen/space_lg"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/space_2xl">

            <!-- 密钥输入 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.PasswordDisk.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_md">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/secretLayout"
                        style="@style/Widget.PasswordDisk.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/totp_secret_hint"
                        app:endIconContentDescription="@string/scan_qr"
                        app:endIconDrawable="@drawable/ic_qr_scan"
                        app:endIconMode="custom"
                        app:endIconTint="?attr/colorPrimary"
                        app:helperText="@string/secret_helper"
                        app:helperTextEnabled="true">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/secretInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:inputType="textCapCharacters"
                            android:maxLines="2"
                            android:paddingEnd="48dp"
                            android:textSize="15sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/generateButton"
                        style="@style/Widget.PasswordDisk.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:text="@string/generate_code"
                        app:icon="@drawable/ic_timer" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 扫码 / 输入来源 -->
            <TextView
                android:id="@+id/issuerText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:layout_marginStart="4dp"
                android:textAppearance="@style/TextAppearance.PasswordDisk.Caption"
                android:textColor="?attr/colorSecondary"
                android:visibility="gone" />

            <!-- 验证码卡片 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/codeCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:visibility="gone"
                app:cardBackgroundColor="?attr/colorPrimary"
                app:cardCornerRadius="@dimen/radius_xl"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/space_xl"
                    android:paddingBottom="@dimen/space_2xl">

                    <FrameLayout
                        android:layout_width="196dp"
                        android:layout_height="196dp">

                        <!--
                            indicatorSize 必须比控件本身小，否则 5dp 的环宽会画到边界之外，
                            右侧和下侧被 View 的裁剪边界切平成直线（看起来像被卡片压住）。
                            这里留 6dp 余量：184 + 5 = 189 < 196。
                        -->
                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/progressRing"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:indeterminate="false"
                            android:max="30"
                            app:indicatorColor="?attr/colorSecondary"
                            app:indicatorSize="184dp"
                            app:trackColor="@color/white_20"
                            app:trackCornerRadius="4dp"
                            app:trackThickness="5dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/codeText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:letterSpacing="0.06"
                                android:text="@string/code_placeholder"
                                android:textColor="?attr/colorOnPrimary"
                                android:textSize="32sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/timerText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textColor="@color/white_70"
                                android:textSize="12sp" />

                        </LinearLayout>

                    </FrameLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/copyButton"
                        style="@style/Widget.PasswordDisk.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="@string/copy_code"
                        android:textColor="?attr/colorOnPrimary"
                        app:icon="@drawable/ic_copy"
                        app:iconTint="?attr/colorOnPrimary" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:lineSpacingExtra="3dp"
                android:text="@string/totp_hint"
                android:textAppearance="@style/TextAppearance.PasswordDisk.Caption" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
