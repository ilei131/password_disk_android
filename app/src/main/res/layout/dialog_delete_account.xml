<?xml version="1.0" encoding="utf-8"?>
<!--
  删除数据对话框。内容包一层 ScrollView：键盘弹出、对话框被压缩时仍可滚动。
  用过的云端账号会在这里显示用户名，只要求补一次密码。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/dialogMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp"
            android:text="@string/delete_data_message"
            android:textAppearance="@style/TextAppearance.PasswordDisk.Body"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <!-- 本机记录过云端账号时才显示，让用户确认删的是哪个账号 -->
        <LinearLayout
            android:id="@+id/cloudAccountRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_search"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_md"
            android:visibility="gone">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_cloud"
                app:tint="?attr/colorPrimary" />

            <TextView
                android:id="@+id/cloudAccountLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:textAppearance="@style/TextAppearance.PasswordDisk.Caption"
                android:textColor="?attr/colorOnSurface"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cloudPasswordGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/credentialHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/delete_cloud_password_hint"
                android:textAppearance="@style/TextAppearance.PasswordDisk.Caption" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/cloudPasswordLayout"
                style="@style/Widget.PasswordDisk.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/cloud_account_password_hint"
                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/cloudPasswordInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="textPassword"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
