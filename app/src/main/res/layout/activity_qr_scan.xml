<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- 相机预览：centerCrop 铺满整屏，不留黑边 -->
    <com.journeyapps.barcodescanner.DecoratedBarcodeView
        android:id="@+id/zxing_barcode_scanner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:zxing_preview_scaling_strategy="centerCrop"
        app:zxing_use_texture_view="false" />

    <!-- 自绘取景遮罩：圆角挖空 + 四角标记 + 扫描光带 -->
    <com.passworddisk.app.ui.ScanOverlayView
        android:id="@+id/scanOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 顶部：关闭 + 标题 -->
    <LinearLayout
        android:id="@+id/scanTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/scanCloseButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_scan_glass"
            android:contentDescription="@string/scan_close"
            android:padding="12dp"
            android:src="@drawable/ic_close"
            app:tint="@android:color/white" />

        <TextView
            android:id="@+id/scanTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="-0.01"
            android:text="@string/scan_title"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="4dp"
            android:text="@string/scan_hint"
            android:textColor="@color/white_70"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- 底部：提示 + 手电筒 -->
    <LinearLayout
        android:id="@+id/scanBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">

        <TextView
            android:id="@+id/scanHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="@string/scan_qr_prompt"
            android:textColor="@color/white_70"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/scanTorchButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_scan_glass"
            android:contentDescription="@string/scan_torch_on"
            android:padding="13dp"
            android:src="@drawable/ic_flashlight"
            app:tint="@android:color/white" />

    </LinearLayout>

</FrameLayout>
