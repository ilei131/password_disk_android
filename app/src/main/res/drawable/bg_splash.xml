<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#0C1F33"
                android:centerColor="#16324F"
                android:endColor="#1D4467"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="60%p"
                android:startColor="#330E9F6E"
                android:endColor="#000E9F6E" />
        </shape>
    </item>
</layer-list>
