<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标前景。
  安全区规则：108dp 画布中只有中心 72dp 会被显示，关键图形应收在直径 66dp 的圆内。
  原始盾牌高 68dp（y 22→90）几乎顶满可见区，圆形/圆角方形遮罩下底部两角会被切掉，
  因此整体缩放到 75%，再上移 2dp 让视觉中心落回 (54, 54)。
  缩放后盾牌约 42×51dp，四周留白 28.5dp，斜对角 33dp 仍在安全圆内。
  要再调大小，只改下面 group 的 scaleX / scaleY。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group android:translateY="-2">

        <group
            android:pivotX="54"
            android:pivotY="56"
            android:scaleX="0.75"
            android:scaleY="0.75">

            <path
                android:fillColor="#FFFFFF"
                android:pathData="M54,22L82,33V54C82,71.5 69.5,84.5 54,90C38.5,84.5 26,71.5 26,54V33L54,22Z" />

            <path
                android:fillColor="#16324F"
                android:pathData="M46,50a8,8 0 1,0 16,0a8,8 0 1,0 -16,0Z" />

            <path
                android:fillColor="#16324F"
                android:pathData="M50.5,56h7v14h-7z" />

            <!-- 绿色状态点：与锁孔圆同心，读作「锁孔里的安全指示灯」。
                 放在盾牌右上角会悬在轮廓外，像一颗掉出来的珠子。 -->
            <path
                android:fillColor="#0E9F6E"
                android:pathData="M49.5,50a4.5,4.5 0 1,0 9,0a4.5,4.5 0 1,0 -9,0Z" />

        </group>

    </group>

</vector>
